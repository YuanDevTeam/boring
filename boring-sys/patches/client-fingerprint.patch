+int SSL_set_client_fingerprint(SSL *ssl, unsigned profile) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl || !ssl_impl->config || ssl_impl->server || SSL_is_dtls(ssl) ||
+      SSL_is_quic(ssl) || ssl_impl->s3->initial_handshake_complete ||
+      (ssl_impl->s3->hs != nullptr && ssl_impl->s3->hs->max_version != 0) ||
+      ssl_impl->config->client_fingerprint != 0 || profile < 1 || profile > 9) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+  // Configure the real native TLS1.3 list so the wire offer and the server's
+  // selection checks share one policy. Preserve the caller's allowed ciphers.
+  static const uint16_t kChrome[] = {
+      SSL_CIPHER_AES_128_GCM_SHA256, SSL_CIPHER_AES_256_GCM_SHA384,
+      SSL_CIPHER_CHACHA20_POLY1305_SHA256};
+  static const uint16_t kFirefox[] = {
+      SSL_CIPHER_AES_128_GCM_SHA256, SSL_CIPHER_CHACHA20_POLY1305_SHA256,
+      SSL_CIPHER_AES_256_GCM_SHA384};
+  static const uint16_t kCnsa[] = {
+      SSL_CIPHER_AES_256_GCM_SHA384, SSL_CIPHER_AES_128_GCM_SHA256,
+      SSL_CIPHER_CHACHA20_POLY1305_SHA256};
+  const Span<const uint16_t> order =
+      profile == 3 ? Span(kFirefox)
+      : ssl_impl->config->compliance_policy == ssl_compliance_policy_cnsa_202407
+          ? Span(kCnsa)
+          : Span(kChrome);
+  uint16_t ciphers[3];
+  size_t num_ciphers = 0;
+  for (uint16_t cipher : order) {
+    if (ssl_impl->config->tls13_cipher_list.Contains(cipher)) {
+      ciphers[num_ciphers++] = cipher;
+    }
+  }
+  if (num_ciphers != 0 &&
+      !SSL_set1_tls13_ciphers(ssl, ciphers, nullptr, num_ciphers)) {
+    return 0;
+  }
+  ssl_impl->config->client_fingerprint = static_cast<uint8_t>(profile);
+  return 1;
+}
