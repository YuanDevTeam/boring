+// Fixed legacy profiles retain their conditional RFC7685 padding. The native
+// PSK encoder and its binders remain unchanged; only the encoded length is used.
+static size_t profile_pre_shared_key_clienthello_length(
+    const SSL_HANDSHAKE *hs, ssl_client_hello_type_t type) {
+  if (!should_offer_psk(hs, type)) {
+    return 0;
+  }
+  size_t len = 2 + 2 + 2 + 2;
+  for (const auto &psk : hs->pre_shared_keys) {
+    len += 2 + ssl_pre_shared_key_identity(psk).size();
+    len += 4;
+    len += 1 + EVP_MD_size(ssl_pre_shared_key_hash(psk));
+  }
+  return len;
+}
